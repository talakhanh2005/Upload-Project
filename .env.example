NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/course_submission
JWT_SECRET=replace-with-at-least-32-random-characters
APP_TIMEZONE=Asia/Ho_Chi_Minh
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./uploads
# Use `oauth` for one centrally connected Drive account, or
# `workspace-delegation` for Google Workspace domain-wide delegation.
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4001/oauth2/callback
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Store this as a platform secret. Newlines may be encoded as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Production: point to your deployed backend URL (e.g. Render).
# NEXT_PUBLIC_API_URL=https://upload-project-38cr.onrender.com/api
# Development (local): use the local backend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
