{
  "name": "course-submission-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @upload/api & npm run dev --workspace @upload/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "overrides": {
    "@nestjs/mongoose": {
      "@nestjs/common": "12.3.2",
      "@nestjs/core": "12.3.2"
    },
    "@nestjs/config": { "@nestjs/common": "12.3.2" },
    "@nestjs/jwt": { "@nestjs/common": "12.3.2" },
    "@nestjs/passport": { "@nestjs/common": "12.3.2" }
  },
  "engines": { "node": "22.x" }
}
